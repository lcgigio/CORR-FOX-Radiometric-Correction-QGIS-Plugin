     <widget class="QWidget" name="tab_apresentacao">
      <attribute name="title">
       <string>0 Tutorial</string>
      </attribute>
      <widget class="QLabel" name="label_9">
       <property name="geometry">
        <rect>
         <x>30</x>
         <y>210</y>
         <width>781</width>
         <height>441</height>
        </rect>
       </property>
       <property name="text">
        <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;h1 align=&quot;center&quot; style=&quot; margin-top:18px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:xx-large; font-weight:600;&quot;&gt;Welcome to Corr. FOX&lt;/span&gt;&lt;/h1&gt;&lt;p align=&quot;justify&quot;&gt;The Corr. FOX plugin was designed to perform radiometric band calibration, specifically tailored for multispectral cameras mounted on drones&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;or Remotely Piloted Aircraft (RPAs) and field panels, utilizing the Empirical Line method.&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;&lt;br/&gt;&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Primary Goal:&lt;/span&gt; To convert Digital Number (DN) images into absolute reflectance values (ranging from 0.0 to 1.0) based on known ground calibration targets,&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;such as calibration panels or homogeneous surfaces.&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;&lt;br/&gt;&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Standard Workflow:&lt;/span&gt;&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;&lt;br/&gt;&lt;/p&gt;&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;&gt;&lt;li align=&quot;justify&quot; style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Setup:&lt;/span&gt; Link the raster images to their corresponding bands or select the directory where the files are stored.&lt;/li&gt;&lt;li align=&quot;justify&quot; style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Sampling:&lt;/span&gt; Use the interactive tools to delineate the calibration panels/targets directly on the map.&lt;/li&gt;&lt;li align=&quot;justify&quot; style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Reflectance Input:&lt;/span&gt; Enter the known reflectance values for the targets (either manually or by importing a TXT/CSV file).&lt;/li&gt;&lt;li align=&quot;justify&quot; style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Calibration:&lt;/span&gt; Execute the process to calculate the band-specific equations and generate the newly corrected raster layers directly within your project.&lt;/li&gt;&lt;li align=&quot;justify&quot; style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Export:&lt;/span&gt; Save your visual reports (PDF) alongside your tabular and spatial data (CSV/SHP).&lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</string>
       </property>
      </widget>
